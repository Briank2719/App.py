LICENSE_FILE = "license.json"
TRIAL_DAYS = 7.5
def is_internet():
    try:
        socket.create_connection(("8.8.8.8", 53), timeout=3)
        return True
    except:
        return False
def auto_renew_check():
    try:
        if not is_internet():
            return True, TRIAL_DAYS
        # Check local license
        if not os.path.exists(LICENSE_FILE):
            data = {"first_launch": datetime.datetime.now().isoformat()}
            with open(LICENSE_FILE, "w") as f: json.dump(data, f)
            return True, TRIAL_DAYS
        with open(LICENSE_FILE, "r") as f:
            data = json.load(f)
        first = datetime.datetime.fromisoformat(data["first_launch"])
        used = (datetime.datetime.now() - first).total_seconds() / 86400
        if used >= TRIAL_DAYS:
            # Try auto-renew via internet
            print("Trial expired, trying auto-renew via internet...")
            try:
                urllib.request.urlopen(SERVER_URL, timeout=5)
                # If server reachable, renew
                data = {"first_launch": datetime.datetime.now().isoformat()}
                with open(LICENSE_FILE, "w") as f: json.dump(data, f)
                print("AUTO-RENEWED! New 7.5 days started")
                return True, TRIAL_DAYS
            except:
                print("No server, but internet found - auto renewing local")
                data = {"first_launch": datetime.datetime.now().isoformat()}
                with open(LICENSE_FILE, "w") as f: json.dump(data, f)
                return True, TRIAL_DAYS
        return True, TRIAL_DAYS - used
    except:
        return False, 0
