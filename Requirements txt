def build_truck(pos, data):
    root = Entity(model='cube', scale=data['scale'], pos=pos, color=data['color'], collider='box')
    cabin = Entity(parent=root, model='cube', scale=(0.98,0.7,0.45), pos=(0,0.35,0.38), color=data['color'])
    Entity(parent=cabin, model='cube', scale=(0.9,0.35,0.05), pos=(0,0.1,0.26), color=color.rgba(150,220,255,180))
    root.wheels = []
    for wx in [-1.2,1.2]:
        for wz in [1.0,0.0,-0.8,-1.6]:
            w = Entity(parent=root, model='cube', scale=(0.5,0.6,0.6), pos=(wx,-0.6,wz), color=color.black, rotation_z=90)
            root.wheels.append(w)
    return root
